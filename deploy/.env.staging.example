# ============================================================================
#  STAGING configuration.
#
#  Copy to `.env.staging`. It is NOT `.env` — the two files sitting side by
#  side with different names is the point, because the mistake this whole
#  arrangement guards against is somebody copying a production `.env` onto a
#  staging box to get it working quickly.
#
#  THE THREE THINGS THAT MAKE THIS SAFE, and none of them is a convention:
#
#   1. XETRAL_ENVIRONMENT=staging makes the API REFUSE. For VTpass that is at
#      BOOT, on the URL. For Bitnob it can no longer be — v2 serves sandbox
#      and production from one host and the SECRET selects between them — so
#      the client asks `/api/whoami` before its first request and refuses a
#      `live` account. Neither is a warning: one exits, the other throws.
#   2. NOTIFICATION_ALLOWLIST is the only set of addresses that can be emailed,
#      and unset means nobody.
#   3. Every secret below is DIFFERENT from production's. A staging box holding
#      a production signing key can mint tokens production will accept.
# ============================================================================

XETRAL_ENVIRONMENT=staging

# ---------------------------------------------------------------------------
#  Secrets — generate FRESH ones. Do not copy production's.
#
#    ACCESS_TOKEN_KEYS: "v1:$(openssl rand -base64 32)"
#    ENCRYPTION_KEYS:   "v1:$(openssl rand -base64 32)"
#
#  The access-token key is the one that matters most: staging and production
#  sharing it means a token minted by a test account is accepted by the real
#  API. The encryption key matters in the other direction — sharing it means a
#  staging box can open production's sealed envelopes.
# ---------------------------------------------------------------------------
ACCESS_TOKEN_KEYS=
ACCESS_TOKEN_CURRENT_VERSION=v1
ENCRYPTION_KEYS=
ENCRYPTION_CURRENT_VERSION=v1

# Fingerprints a BVN so two accounts cannot both be verified against one
# person. `v1:<base64>`, at least 32 bytes — this keys an HMAC, which takes a
# key of any length, unlike AES-256 above which takes exactly 32.
#
# SEPARATE FROM THE KEYS ABOVE, and rotated separately. A blind index cannot
# have two live keys: matching requires exactly one, so changing this means
# recomputing every fingerprint with
# `node scripts/backfill-bvn-fingerprint.mjs --all`. Until that finishes the
# duplicate-BVN rule cannot see across the boundary, and
# `kyc_blind_index_versions` says so.
#
#   KYC_BLIND_INDEX_KEY="v1:$(openssl rand -base64 32)"
KYC_BLIND_INDEX_KEY=


POSTGRES_PASSWORD=
DATABASE_URL=postgres://xetral:CHANGE_ME@postgres:5432/xetral
REDIS_URL=redis://redis:6379

# Cloudflare plus Coolify's router is two. Staging is usually behind fewer, and
# getting this wrong is not cosmetic: too high and a client can spoof
# X-Forwarded-For to dodge per-IP rate limiting entirely.
TRUST_PROXY_HOPS=1

# Request rate limits. Left at the production defaults deliberately: a staging
# environment whose limiter behaves differently from production's is one that
# cannot be used to find out whether the limits are right.

# ---------------------------------------------------------------------------
#  PROVIDERS — SANDBOX ONLY.
#
#  VTpass still has two hosts and the API refuses at boot on the wrong one:
#
#    live     https://vtpass.com
#    sandbox  https://sandbox.vtpass.com
#
#  BITNOB NO LONGER DOES. v2 has one address for both, and the secret decides.
#  A URL cannot answer the question, so the guard moved to where the secret is
#  used — see below.
# ---------------------------------------------------------------------------
# THE SAME HOST PRODUCTION USES, and there is no other one. Bitnob v2 has no
# sandbox address: the secret below is what decides whether the money is real.
# That is why the boot-time guard on this file can no longer check the URL,
# and why the API asks `/api/whoami` before its first request on staging and
# refuses a live account.
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
# MUST be the sandbox secret. A live one here issues real cards from a box
# whose database is usually a copy of production.
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=

VTPASS_BASE_URL=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=

# Airalo and Twilio have their own sandbox arrangements; leave them unset and
# those routes refuse, which is a perfectly good staging state.
AIRALO_BASE_URL=
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=

TWILIO_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER_PRICE_CENTS=

# ---------------------------------------------------------------------------
#  EMAIL — WHO STAGING IS ALLOWED TO REACH.
#
#  A staging database is usually restored from a production backup, because
#  that is the only way to test against realistic data. The moment it is, the
#  outbox worker is holding every real customer's address and a queue of
#  messages about transfers that never happened, and it will send them. The
#  recipients never agreed to hear from a test system and it cannot be undone.
#
#  Suffix match, so plus-addressing works without listing individuals.
#  EMPTY MEANS NOBODY, which is the direction to be wrong in.
# ---------------------------------------------------------------------------
NOTIFICATION_ALLOWLIST=@xetral.com

RESEND_API_KEY=
NOTIFICATION_FROM=Xetral Staging <no-reply@staging.xetral.com>
APP_BASE_URL=https://staging.xetral.com
OPERATIONS_EMAIL=

# ---------------------------------------------------------------------------
#  Feature flags. Staging is where gift cards SHOULD be on — it is the only
#  place the flow can be exercised end to end without paying a real person for
#  a bearer instrument nobody can verify.
# ---------------------------------------------------------------------------
GIFT_CARDS_ENABLED=true
GIFT_CARD_HOLD_DAYS=1

# Deliberately small, so a wrong amount unit is caught on the first sandbox
# deposit rather than on the first real one.
DEPOSIT_CEILING_KOBO=10000000
