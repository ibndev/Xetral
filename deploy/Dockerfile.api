# The API, built once and run as a non-root user.
FROM node:22-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN npm ci --workspace @xetral/api --include-workspace-root
RUN npm run build --workspace @xetral/api

FROM node:22-alpine
WORKDIR /app
# Never root. A process that only needs to read its own bundle and open a
# socket has no business being able to write to the image.
RUN addgroup -S xetral && adduser -S xetral -G xetral
COPY --from=build --chown=xetral:xetral /repo/apps/api/dist ./dist
COPY --from=build --chown=xetral:xetral /repo/node_modules ./node_modules
USER xetral
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["node", "dist/main.js"]
