# Which deployment this is. REQUIRED, with no default: a production box
# falling back to `staging` would relax the guards that protect real
# customers, and no default is safe enough to be worth having.
XETRAL_ENVIRONMENT=production

# =============================================================================
#  Xetral — deployment configuration
#
#  Every value here has a consequence, and the comments say what it is. Nothing
#  has a development-friendly default: a placeholder that "works" is how a
#  production system ends up verifying tokens with a secret published on
#  GitHub.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# The PRIVATE address of the primary. If this is reachable from the internet,
# the topology is wrong.
DATABASE_URL=postgres://xetral:CHANGE_ME@10.0.0.2:5432/xetral?sslmode=require

# Replication role, used only by the standby.
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME

# ---- Redis ------------------------------------------------------------------
# When absent, rate limiting is IN-PROCESS and the limit multiplies by the
# number of instances. Correct for one box, silently wrong for two.
REDIS_URL=redis://redis:6379

# ---- Access tokens ----------------------------------------------------------
# `v1:<base64>,v2:<base64>`. Generate with:
#   openssl rand -base64 32
# Two keys can be present at once so rotation is a two-deploy operation:
# publish the new key everywhere first, then switch the current version.
ACCESS_TOKEN_KEYS=
ACCESS_TOKEN_CURRENT_VERSION=v1

# The exact window a STOLEN access token keeps working, because a signed token
# cannot be revoked mid-life. Raising this is a security decision.
ACCESS_TOKEN_TTL_SECONDS=900

# ---- Encryption -------------------------------------------------------------
# Seals delivery payloads and gift card codes. EXACTLY 32 bytes per key.
# Retired keys stay listed so old rows still open; only the current one writes.
ENCRYPTION_KEYS=
ENCRYPTION_CURRENT_VERSION=v1

# ---- Proxy ------------------------------------------------------------------
# Cloudflare plus the node's own router is 2. Too high and a client can spoof
# X-Forwarded-For to dodge per-IP rate limiting; too low and every request
# appears to come from the proxy, so one bucket throttles all customers.
TRUST_PROXY_HOPS=2

# ---- Bitnob -----------------------------------------------------------------
BITNOB_BASE_URL=https://api.bitnob.co/api/v1
BITNOB_API_KEY=
BITNOB_WEBHOOK_SECRET=

# How Bitnob expresses an NGN deposit amount. Confirm against the FIRST real
# deposit: if this is wrong the deposit lands in suspense rather than in
# somebody's balance, which is the recoverable direction.
BITNOB_NGN_AMOUNT_UNIT=kobo

# Refuse to auto-credit above this, in kobo. This is the control that makes a
# misread amount recoverable — a factor-of-100 error blows it and the money is
# held instead of spent. Default 1,000,000.00 NGN.
#
# ALSO A PLATFORM SETTING, and the database wins. See the note at the bottom.
DEPOSIT_CEILING_KOBO=100000000

# ---- Fulfilment providers ---------------------------------------------------
VTPASS_BASE_URL=https://vtpass.com
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=

AIRALO_BASE_URL=https://partners-api.airalo.com
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=

TWILIO_BASE_URL=https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# What WE charge per number, in cents. Not what Twilio charges us. An instance
# that has not set this cannot sell a number.
TWILIO_NUMBER_PRICE_CENTS=

# ---- Fees -------------------------------------------------------------------
# Basis points (150 = 1.5%). Defaults to ZERO, deliberately: a fee nobody
# configured is money taken from a customer because of a default.
#
# ALSO A PLATFORM SETTING, and the database wins. Change the fee in the admin
# dashboard, not here — this value only applies before `platform_settings` can
# be read. Bootstrap logs a warning if the two disagree.
TRANSFER_FEE_BASIS_POINTS=0

# ---- Background workers -----------------------------------------------------
# These are read by the `worker` service ONLY. docker-compose.app.yml blanks
# every one of them on `api`, so the API can be scaled without four processes
# asking Bitnob about the same purchase. That used to be a comment saying "set
# these on exactly one instance", which `env_file` made impossible to honour.
#
# WITHOUT THE WORKER RUNNING, NOTHING RECONCILES: a lost deposit webhook is
# never found, a purchase held on a timeout is never resolved, and an approved
# gift card payout is never released.
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_STALE_SECONDS=86400
DEPOSIT_RECONCILE_INTERVAL_SECONDS=600
CRYPTO_RECONCILE_INTERVAL_SECONDS=600
# Deposits as well as withdrawals. Without this a crypto deposit whose webhook
# was lost is money on a chain that never reaches a balance.
CRYPTO_DEPOSIT_RECONCILE_INTERVAL_SECONDS=600

# ---- Gift cards -------------------------------------------------------------
# Ships OFF. Anything other than the exact string 'true' is false.
#
# THIS FLAG IS ONE OF TWO SWITCHES. Gift cards are on only when this is true
# AND `gift_cards_enabled` is true in the admin dashboard — the one flow that
# pays out against a bearer instrument nobody can verify at the moment of
# payment gets two keys, and either being off means off. Every other setting is
# decided by the database alone.
GIFT_CARDS_ENABLED=false
# Also a platform setting; the database wins.
GIFT_CARD_HOLD_DAYS=3
# Required when gift cards are on, on exactly one instance. Without it,
# customers are paid and can never spend it.
GIFTCARD_RELEASE_INTERVAL_SECONDS=

# ---- Web --------------------------------------------------------------------
# Server-side only, deliberately not NEXT_PUBLIC_. The browser talks to the web
# app's own route handlers, which hold the refresh token in an httpOnly cookie.
XETRAL_API_URL=http://api:3000

# -----------------------------------------------------------------------------
#  EMAIL, AND WHAT STOPS WORKING WITHOUT IT
#
#  Password reset is UNAVAILABLE without these. There is no other way to prove
#  control of an address, so a customer who forgets their password has no route
#  back to their money. New-device alerts and receipts are also silent.
#
#  NOTIFICATION_FROM must be on a domain whose SPF, DKIM and DMARC records name
#  the provider. Security mail from an unauthenticated domain lands in spam,
#  which is indistinguishable from not sending it.
#
#  APP_BASE_URL is what reset links are built from. It is validated as an
#  absolute https URL and is NEVER read from a request header — a Host an
#  attacker controls would turn our own reset email into a credential harvester
#  carrying our branding.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM=Xetral <no-reply@xetral.com>
NOTIFICATION_REPLY_TO=support@xetral.com
APP_BASE_URL=https://app.xetral.com
PASSWORD_RESET_TTL_MINUTES=30

# -----------------------------------------------------------------------------
#  WHO HEARS ABOUT A FAILURE
#
#  Without OPERATIONS_EMAIL, failures are recorded in `error_events` and nobody
#  is told. The table is still worth having — it is what the dashboard reads —
#  but the whole point is not having to remember to look.
# -----------------------------------------------------------------------------
OPERATIONS_EMAIL=

# -----------------------------------------------------------------------------
#  BACKUPS
#
#  Generate the keypair OFF these machines:
#
#    age-keygen -o xetral-backup.key
#
#  The `age1...` public line goes here. The FILE goes wherever restores are
#  run from — a password manager, a safe, an operator's laptop — and never onto
#  a database host. That separation is what makes a compromise of the database
#  node yield the archives without their contents, and it is the only reason
#  encrypting them is worth anything.
#
#  The backup container REFUSES TO START without a recipient. An unencrypted
#  nightly copy of a customer ledger is not a degraded mode.
# -----------------------------------------------------------------------------
BACKUP_AGE_RECIPIENT=

# An rclone remote and path. Use a bucket in a DIFFERENT REGION, with object
# lock or versioning on, and give these credentials write-only access —
# a compromised database host must not be able to delete its own history.
BACKUP_REMOTE=remote:xetral-backups/prod
RCLONE_CONFIG_REMOTE_TYPE=s3
RCLONE_CONFIG_REMOTE_PROVIDER=
RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_REMOTE_ENDPOINT=
RCLONE_CONFIG_REMOTE_REGION=

BACKUP_KEEP_DAYS=14

# =============================================================================
#  WHAT IS NOT IN THIS FILE
#
#  Fees, ceilings, daily limits and feature flags live in `platform_settings`
#  and are changed in the admin dashboard by somebody with the `finance` role.
#  They are rows so that changing a fee is not a deploy, and so that every
#  change is bounded by a CHECK and written to history with who made it.
#
#  The values above are the fallback used only until that table can be read.
#  If one of them disagrees with the database, the DATABASE WINS and bootstrap
#  logs a warning naming both — because "I set the environment variable and
#  nothing happened" is otherwise an afternoon.
#
#  Before taking real traffic:
#
#   1. Apply 009_admin.sql and 009_admin.seed.sql along with the rest.
#   2. Grant `admin` to a real person. The FIRST grant has no admin to make
#      it, so it is an INSERT:
#
#        INSERT INTO staff_roles (user_id, role, granted_by)
#        SELECT id, 'admin', id FROM users WHERE email = 'you@xetral.com';
#
#      Every later grant goes through the dashboard, where it is audited.
#   3. Grant the narrower roles from there — `support` reads, `compliance`
#      reviews identity and freezes accounts, `finance` moves suspense money
#      and changes settings. Grant the narrowest role that does the job.
#   4. Read every row in `platform_settings` and decide each one deliberately.
#      The seeded defaults are safe, not correct for your business.
#   5. Set the worker intervals on EXACTLY ONE instance. `docker-compose.app.yml`
#      does this by blanking them on `api` and setting them on `worker`:
#
#        RECONCILE_INTERVAL_SECONDS, DEPOSIT_RECONCILE_INTERVAL_SECONDS,
#        CRYPTO_RECONCILE_INTERVAL_SECONDS,
#        CRYPTO_DEPOSIT_RECONCILE_INTERVAL_SECONDS,
#        GIFTCARD_RELEASE_INTERVAL_SECONDS, NOTIFICATION_INTERVAL_SECONDS,
#        ERROR_ALERT_INTERVAL_SECONDS
#
#      NOTIFICATION_INTERVAL_SECONDS is the one whose absence is silent in the
#      worst way: rows accumulate, the API keeps answering "check your email",
#      and no email is ever sent.
#   6. Enrol a second factor for every person holding a staff role. Every
#      /v1/admin/ route refuses without one, so a role granted to somebody who
#      has not enrolled is a role that does nothing. `staff_without_second_factor`
#      is the view that answers "is anybody missing?".
#   7. Run `standby/restore-drill.sh` — from a machine that is NOT a database
#      node, holding the private age key — and put it in a calendar. It fetches
#      the newest archive, decrypts it, restores it into a scratch instance and
#      then INTERROGATES THE LEDGER: every entry sums to zero per currency, the
#      materialised balances agree with the postings, no customer is overdrawn.
#      A copy that starts is not a copy that is intact, and an untested backup
#      is a hope with a cron entry.
# =============================================================================
