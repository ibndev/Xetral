# Copy to .env and fill in. .env is gitignored — a leaked signing key is a
# leaked session for every customer.

DATABASE_URL=postgres://xetral@localhost:5432/xetral

# Access token signing keys, as <version>:<base64 secret>, comma separated.
# At least 32 bytes each. Generate with:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# Rotation is two deploys: add the new key here and ship it everywhere FIRST,
# then move ACCESS_TOKEN_CURRENT_VERSION. Signing with a key half the fleet
# cannot verify produces intermittent 401s that look like a load-balancer fault.
ACCESS_TOKEN_KEYS=v1:REPLACE_ME
ACCESS_TOKEN_CURRENT_VERSION=v1

# 900 seconds. This is the exact window a stolen access token keeps working,
# because a signed token cannot be revoked before it expires. Raising it is a
# security decision; values above 3600 are refused at boot.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Both buckets must pass. Per-identifier stops a botnet spraying one account;
# per-IP stops one address walking a list of accounts.
LOGIN_RATE_LIMIT_PER_IDENTIFIER=10
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Proxy hops in front of the app (Cloudflare + Coolify router = 2).
TRUST_PROXY_HOPS=1

PORT=3000
