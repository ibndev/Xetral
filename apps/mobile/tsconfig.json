{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["react", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
