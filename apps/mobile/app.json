{
  "expo": {
    "name": "Xetral",
    "slug": "xetral",
    "scheme": "xetral",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xetral.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Xetral uses Face ID to unlock your transaction PIN."
      }
    },
    "android": {
      "package": "com.xetral.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/xetral.png",
        "backgroundColor": "#0D1B3E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Xetral uses Face ID to unlock your transaction PIN."
        }
      ],
      "expo-notifications",
      "./plugins/with-lan-cleartext",
      "./plugins/with-release-signing"
    ],
    "extra": {
      "apiUrl": "https://app.xetral.com/api/x"
    },
    "icon": "./assets/icon/xetral.png"
  }
}
