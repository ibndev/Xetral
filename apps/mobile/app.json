{
  "expo": {
    "name": "Xetral",
    "slug": "xetral",
    "scheme": "xetral",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.xetral.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Xetral uses Face ID to unlock your transaction PIN."
      }
    },
    "android": {
      "package": "ng.xetral.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Xetral uses Face ID to unlock your transaction PIN."
        }
      ],
      "./plugins/with-lan-cleartext"
    ],
    "extra": {
      "apiUrl": "https://app.xetral.com/api/x"
    }
  }
}
