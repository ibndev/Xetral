node_modules/
dist/
build/
.turbo/

# Secrets. Nothing here should ever reach a commit — a leaked provider key
# is a leaked customer balance.
.env
.env.*
!.env.example
# `.env.*` also swallowed this one, so the staging template `PHASES.md` and
# `docker-compose.staging.yml` both point at had never actually been in the
# repository — a documented file that does not exist. It holds placeholders
# and no values; the rule above still ignores every real `.env.*`.
!.env.staging.example
*.pem
*.key

# Local Postgres data used by the ledger tests
pgdata/

.DS_Store
*.log
.vscode/
.idea/

# Redis writes this wherever it was started
dump.rdb

# Next.js build output
.next/
out/

# Expo
.expo/

# TypeScript incremental build state
*.tsbuildinfo

# Generated native projects.
#
# `expo prebuild` writes these from app.json, so app.json is the source of
# truth and a committed copy is a second one that drifts. The APK workflow
# regenerates them on every run; a change to icons, permissions or the bundle
# identifier therefore takes effect without anybody remembering to re-run
# prebuild by hand.
apps/mobile/android/
apps/mobile/ios/
