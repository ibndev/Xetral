    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "multer": "^2.4.0",
    "@expo/metro-config": {
      "postcss": "^8.5.28"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
